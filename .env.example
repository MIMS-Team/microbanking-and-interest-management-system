# ==============================================================================
# Microbanking and Interest Management System (MIMS) - Authentication & Server Config
# ==============================================================================

# Database Configuration (MySQL 8.0 shared backend)
# When configuring MySQL, all four connection parameters below must be explicitly specified.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_mysql_database

# Email / OTP Delivery Configuration
# Options: 'smtp' | 'webhook' | 'console' | 'test'
# In production (NODE_ENV=production), 'smtp' or 'webhook' is required.
EMAIL_PROVIDER=smtp

# SMTP Provider Settings (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="MIMS Security <security@yourbank.com>"

# HTTP Webhook Relay Settings (used when EMAIL_PROVIDER=webhook)
EMAIL_WEBHOOK_URL=https://notifications.internal.bank/api/send-otp
EMAIL_API_KEY=mims_internal_secret_token

# Security Settings
# When true, password reset requests return uniform responses with dummy challenges to defeat timing & user enumeration
ANTI_ENUMERATION=true

# Set to true if the application is deployed behind a trusted reverse proxy (NGINX, Cloudflare, ALB)
TRUST_PROXY=false

# Application URL for CSRF validation & links
APP_URL=http://127.0.0.1:3000

# Legacy PostgreSQL/PGlite banking modules (not yet unified with MySQL).
# Leave DATABASE_URL empty to run those modules locally through PGlite.
# Use one Next.js process when using the embedded database.
DATABASE_URL=
# For a regular PostgreSQL server, for example:
# DATABASE_URL=postgresql://mims:choose-a-password@localhost:5432/mims
# Seed fictional demo data only in your development/course database.
SEED_DEMO=true
# Local demo only: show the generated OTP on the login screen.
DEMO_OTP=true
# For a production build running as a local demo only:
ALLOW_EMBEDDED_DB=true
# For real email delivery, provide your own HTTPS gateway. It receives
# {email,code,purpose,expires_in_minutes} with a Bearer token header.
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
# Optional daily background processing. Keep the app running as well.
SCHEDULER_KEY=
SCHEDULER_USER_ID=3
# Set APP_URL only to the exact address where you open the app.
# APP_URL=http://127.0.0.1:3000
# Demonstration inactivity policy; the SRS does not specify the duration.
INACTIVITY_DAYS=180
