# ==============================================================================
# Microbanking and Interest Management System (MIMS) - Authentication & Server Config
# ==============================================================================

# Database Configuration (MySQL 8.0 shared backend)
# When configuring MySQL, all four connection parameters below must be explicitly specified.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_mysql_database

# Email / OTP Delivery Configuration
# Options: 'smtp' | 'webhook' | 'console' | 'test'
# In production (NODE_ENV=production), 'smtp' or 'webhook' is required.
EMAIL_PROVIDER=smtp

# SMTP Provider Settings (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="MIMS Security <security@yourbank.com>"

# HTTP Webhook Relay Settings (used when EMAIL_PROVIDER=webhook)
EMAIL_WEBHOOK_URL=https://notifications.internal.bank/api/send-otp
EMAIL_API_KEY=mims_internal_secret_token

# Security Settings
# When true, password reset requests return uniform responses with dummy challenges to defeat timing & user enumeration
ANTI_ENUMERATION=true

# Enable only behind a proxy that OVERWRITES forwarded IP headers and prevents
# direct access to Next.js. Otherwise client-supplied headers can spoof IP limits.
# With false, requests share the fallback 127.0.0.1 IP bucket.
# Rate-limit counters are process-local; see docs/auth-deployment.md.
TRUST_PROXY=false

# Optional absolute SQLite authentication path for local tooling.
# Browser tests supply their own owned temporary path; do not configure E2E flags here.
# MIMS_AUTH_DB_PATH=C:/path/to/local-auth.db

# Application URL for CSRF validation & links
APP_URL=http://127.0.0.1:3000

# Canonical banking uses DB_* above; DATABASE_URL and automatic demo seeding are removed.
# Independent migration credentials. Export these to the setup process; setup does
# not automatically load .env.local or fall back to DB_*.
# MIGRATION_DB_HOST=127.0.0.1
# MIGRATION_DB_PORT=3306
# MIGRATION_DB_USER=mims_migrator
# MIGRATION_DB_PASSWORD=
# MIGRATION_DB_NAME=
# MIGRATION_OPENING_BALANCE_ACTOR_ID= # Only for explicitly reviewed legacy baselines.

# Dedicated disposable verification server, never the shared development server.
# TEST_MYSQL_HOST=127.0.0.1
# TEST_MYSQL_PORT=33307
# TEST_MYSQL_USER=
# TEST_MYSQL_PASSWORD=
# TEST_MYSQL_REQUIRED=true
# MYSQL_BIN_DIRECTORY=C:/Program Files/MySQL/MySQL Server 8.0/bin
# OPENSSL_BIN=C:/Program Files/Git/usr/bin/openssl.exe

# Business decisions: blank values fail closed for the corresponding processing.
# Supported candidate conventions, only after business approval:
# INTEREST_POLICY=daily-minimum-actual365-monthly-fd
# INACTIVE_INTEREST_POLICY=full-rate
# EARLY_FD_CLOSURE_POLICY=earned-interest-no-penalty
# FD_RENEWAL_POLICY=same-contract
INTEREST_POLICY=
INACTIVE_INTEREST_POLICY=
EARLY_FD_CLOSURE_POLICY=
FD_RENEWAL_POLICY=
INACTIVITY_DAYS=
INACTIVITY_TRANSFER_OUT_COUNTS=
# Configure branch_hours (weekday 0=Monday) and branch_holidays in MySQL.
# No opening hours or inactivity duration is installed automatically.

SCHEDULER_KEY=
SCHEDULER_USER_ID=
BACKUP_TIME_COLOMBO=
# Separate backup principal and restricted absolute storage directory.
BACKUP_DB_HOST=
BACKUP_DB_PORT=3306
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
BACKUP_DB_NAME=
BACKUP_DIRECTORY=
# Random 32-byte hex key, stored separately from encrypted backup files.
BACKUP_ENCRYPTION_KEY=
