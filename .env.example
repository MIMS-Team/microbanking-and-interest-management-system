# Leave DATABASE_URL empty to run PostgreSQL locally through PGlite.
# Use one Next.js process when using the embedded database.
DATABASE_URL=
# For a regular PostgreSQL server, for example:
# DATABASE_URL=postgresql://mims:choose-a-password@localhost:5432/mims
# Seed fictional demo data only in your development/course database.
SEED_DEMO=true
# Local demo only: show the generated OTP on the login screen.
DEMO_OTP=true
# For a production build running as a local demo only:
ALLOW_EMBEDDED_DB=true
# For real email delivery, provide your own HTTPS gateway. It receives
# {email,code,purpose,expires_in_minutes} with a Bearer token header.
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
# Optional daily background processing. Keep the app running as well.
SCHEDULER_KEY=
SCHEDULER_USER_ID=3
# Set APP_URL only to the exact address where you open the app.
# APP_URL=http://127.0.0.1:3000
# Demonstration inactivity policy; the SRS does not specify the duration.
INACTIVITY_DAYS=180
