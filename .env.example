# ==============================================================================
# Microbanking and Interest Management System (MIMS) - Authentication & Server Config
# ==============================================================================

# PostgreSQL / Neon (shared authentication and banking backend)
# Copy the TLS-enabled pooled URL from Neon Connect for application traffic.
# Keep URLs server-side; never prefix them with NEXT_PUBLIC_.
DATABASE_URL=
MIMS_AUTH_DB_ADAPTER=postgres
DB_POOL_MAX=5
# Explicit direct owner/migrator connection, without -pooler in the hostname.
# Set only for operator commands, never in the hosted application's environment.
MIGRATION_DATABASE_URL=
POSTGRES_APP_ROLE=mims_application
# Only used once on an empty staff table; choose different real email accounts
# and different strong passwords, then remove these bootstrap variables.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_HIGHER_EMAIL=
BOOTSTRAP_HIGHER_PASSWORD=
BOOTSTRAP_HIGHER_NAME=
# Dedicated DIRECT local PostgreSQL test server with CREATE DATABASE privileges.
# Every test creates and drops its own random database, never DATABASE_URL.
TEST_DATABASE_URL=
# Explicit direct read-only diagnostics / separate backup connection.
PREFLIGHT_DATABASE_URL=
BACKUP_DATABASE_URL=
PG_DUMP_BINARY=pg_dump
PG_RESTORE_BINARY=pg_restore
# Optional credentials for dev:verify after bootstrapping a real local account.
LOCAL_VERIFY_EMAIL=
LOCAL_VERIFY_PASSWORD=

# Legacy MySQL 8.0 configuration (set MIMS_AUTH_DB_ADAPTER=mysql to use it).
# When configuring MySQL, all four connection parameters below must be explicitly specified.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_mysql_database

# Email / OTP Delivery Configuration
# Options: 'smtp' | 'webhook' | 'console' | 'test'
# In production (NODE_ENV=production), 'smtp' or 'webhook' is required.
EMAIL_PROVIDER=smtp

# SMTP Provider Settings (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="MIMS Security <security@yourbank.com>"

# HTTP Webhook Relay Settings (used when EMAIL_PROVIDER=webhook)
EMAIL_WEBHOOK_URL=https://notifications.internal.bank/api/send-otp
EMAIL_API_KEY=mims_internal_secret_token

# Security Settings
# When true, password reset requests return uniform responses with dummy challenges to defeat timing & user enumeration
ANTI_ENUMERATION=true

# Enable only behind a proxy that OVERWRITES forwarded IP headers and prevents
# direct access to Next.js. Otherwise client-supplied headers can spoof IP limits.
# With false, requests share the fallback 127.0.0.1 IP bucket.
# Rate-limit counters are process-local; see docs/auth-deployment.md.
TRUST_PROXY=false

# Optional absolute SQLite authentication path for local tooling.
# Browser tests supply their own owned temporary path; do not configure E2E flags here.
# MIMS_AUTH_DB_PATH=C:/path/to/local-auth.db

# Application URL for CSRF validation & links
APP_URL=http://127.0.0.1:3000

# Canonical banking shares DATABASE_URL; runtime never seeds banking data.
# Independent migration credentials. Export these to the setup process; setup does
# not automatically load .env.local or fall back to DB_*.
# MIGRATION_DB_HOST=127.0.0.1
# MIGRATION_DB_PORT=3306
# MIGRATION_DB_USER=mims_migrator
# MIGRATION_DB_PASSWORD=
# MIGRATION_DB_NAME=
# MIGRATION_OPENING_BALANCE_ACTOR_ID= # Only for explicitly reviewed legacy baselines.

# Dedicated disposable verification server, never the shared development server.
# TEST_MYSQL_HOST=127.0.0.1
# TEST_MYSQL_PORT=33307
# TEST_MYSQL_USER=
# TEST_MYSQL_PASSWORD=
# TEST_MYSQL_REQUIRED=true
# MYSQL_BIN_DIRECTORY=C:/Program Files/MySQL/MySQL Server 8.0/bin
# OPENSSL_BIN=C:/Program Files/Git/usr/bin/openssl.exe

# Business decisions: blank values fail closed for the corresponding processing.
# Supported candidate conventions, only after business approval:
# INTEREST_POLICY=daily-minimum-actual365-monthly-fd
# INACTIVE_INTEREST_POLICY=full-rate
# EARLY_FD_CLOSURE_POLICY=earned-interest-no-penalty
# FD_RENEWAL_POLICY=same-contract
INTEREST_POLICY=
INACTIVE_INTEREST_POLICY=
EARLY_FD_CLOSURE_POLICY=
FD_RENEWAL_POLICY=
INACTIVITY_DAYS=
INACTIVITY_TRANSFER_OUT_COUNTS=
# Configure branch_hours (weekday 0=Monday) and branch_holidays in the database.
# No opening hours or inactivity duration is installed automatically.

SCHEDULER_KEY=
SCHEDULER_USER_ID=
BACKUP_TIME_COLOMBO=
# Separate backup principal and restricted absolute storage directory.
BACKUP_DB_HOST=
BACKUP_DB_PORT=3306
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
BACKUP_DB_NAME=
BACKUP_DIRECTORY=
# Random 32-byte hex key, stored separately from encrypted backup files.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_ID=
# Approved retention period; blank performs no cleanup. Only inventoried,
# checksum-verified, off-host-exported files are eligible for cleanup.
BACKUP_RETENTION_DAYS=
BACKUP_OFFHOST_URL=
# Explicit failure adapter; blank records 'unconfigured' and sends nothing.
JOB_FAILURE_PROVIDER=
JOB_FAILURE_WEBHOOK_URL=
JOB_LEASE_SECONDS=900
JOB_RETRY_SECONDS=60
JOB_MAX_ATTEMPTS=5
# Disabled until correction authority/treatment is approved.
# CASH_CORRECTION_POLICY=independent-management-active-cash
CASH_CORRECTION_POLICY=
# FD_RENEWAL_POLICY also supports the reviewed candidate current-effective-product.
# The existing request snapshot remains binding when an FD is approved.

# Read-only diagnostic principal: never defaults to runtime credentials.
PREFLIGHT_DB_HOST=
PREFLIGHT_DB_PORT=3306
PREFLIGHT_DB_USER=
PREFLIGHT_DB_PASSWORD=
PREFLIGHT_DB_NAME=
