{
  "name": "btrust-mims",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "scheduler": "node scripts/scheduler.mjs",
    "test": "npm run test:auth && npm run test:banking",
    "test:auth": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:production": "node scripts/run-auth-production-e2e.mjs",
    "test:banking": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:reports": "tsx --test tests/reports.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "db:setup": "tsx scripts/db-setup.ts",
    "lint": "eslint",
    "seed": "node scripts/seed-dev.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "db:migrate:auth": "node scripts/migrate-auth-mysql.mjs",
    "db:backup": "node scripts/database-backup.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "exceljs": "4.4.0",
    "lucide-react": "^1.49.0",
    "mysql2": "^3.24.5",
    "next": "16.3.3",
    "nodemailer": "^10.0.16",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
