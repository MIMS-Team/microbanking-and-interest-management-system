{
  "name": "btrust-mims",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "dev:full": "node -- scripts/start-local.mjs",
    "dev:verify": "node scripts/verify-local.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "start:host": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "scheduler": "node scripts/scheduler.mjs",
    "test": "npm run test:auth && npm run test:banking",
    "test:auth": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:production": "node scripts/run-auth-production-e2e.mjs",
    "test:banking": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:reports": "tsx --test tests/reports.test.ts",
    "test:postgres": "node scripts/run-postgres-tests.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "db:setup": "tsx scripts/db-setup.ts",
    "lint": "eslint",
    "seed": "tsx scripts/seed-disposable.ts",
    "seed:dev": "tsx scripts/seed-disposable.ts",
    "seed:postgres": "tsx scripts/seed-postgres.ts",
    "db:migrate:postgres": "node scripts/migrate-postgres.mjs",
    "db:principals:postgres": "node scripts/postgres-principals.mjs",
    "db:bootstrap:postgres": "tsx scripts/bootstrap-postgres.ts",
    "db:import:mysql": "node scripts/import-mysql-postgres.mjs",
    "db:preflight:postgres": "node scripts/preflight-postgres.mjs",
    "db:preflight": "node scripts/database-preflight.mjs",
    "db:principals": "node scripts/database-principals.mjs",
    "db:recovery-drill": "tsx scripts/recovery-drill.ts",
    "db:migrate:auth": "node scripts/migrate-auth-mysql.mjs",
    "db:backup": "node scripts/backup-router.mjs",
    "db:backup:postgres": "node scripts/backup-postgres.mjs",
    "test:e2e:cross": "node scripts/run-cross-browser.mjs",
    "test:e2e:banking": "node scripts/run-auth-production-e2e.mjs --banking",
    "test:e2e:banking:cross": "node scripts/run-cross-browser.mjs --banking",
    "test:load": "node scripts/run-auth-production-e2e.mjs --load",
    "test:recovery": "node scripts/run-recovery-verification.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "lucide-react": "^1.49.0",
    "mysql2": "^3.24.5",
    "next": "16.3.3",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
