{
  "name": "btrust-mims",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "scheduler": "node scripts/scheduler.mjs",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:auth": "tsx --test tests/auth.test.ts",
    "test:banking": "tsx --test tests/banking.test.ts",
    "test:reports": "tsx --test tests/reports.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "db:setup": "tsx scripts/db-setup.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "exceljs": "4.4.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
